[Icon Theme]
Name=AttackFrame Ghost
Comment=Minimal monochrome outline icons with neon accent dots
Inherits=Papirus-Dark,Adwaita,hicolor
Example=folder
Directories=scalable/places,scalable/apps

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications
